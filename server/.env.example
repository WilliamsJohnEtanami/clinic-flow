# ── Database (Supabase Postgres) ────────────────────────────────────────
# Pooled connection (port 6543) — available for pooled/serverless deployments
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432) — used by the persistent API and Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-generate-a-long-random-string"
JWT_REFRESH_SECRET="change-me-generate-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ── Password reset email (SMTP) ─────────────────────────────────────────
# Gmail users: use smtp.gmail.com and a Google App Password (not the account password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-google-app-password"
# Optional; defaults to SMTP_USER when omitted.
# SMTP_FROM="VitaFlow <your-gmail-address@gmail.com>"
FRONTEND_URL="http://localhost:8080"

# ── Seed / demo ──────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@vitaflow.edu"
SEED_ADMIN_PASSWORD="admin123"
