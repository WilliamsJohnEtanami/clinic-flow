// VitaFlow database schema
// PostgreSQL (hosted on Supabase) via Prisma ORM
// Core business logic lives in the Express backend — this schema only
// defines persistence and relationships.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum Priority {
  EMERGENCY
  ROUTINE
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  CANCELLED
  NO_SHOW
}

enum QueueType {
  WALK_IN
  APPOINTMENT
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  YOU_ARE_NEXT
  DOCTOR_CALLING
  EMERGENCY_IN_QUEUE
  APPOINTMENT_REMINDER
  QUEUE_UPDATED
  GENERAL
}

// ─────────────────────────────────────────────────────────────────────────
// User & Patient
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullName     String
  role         Role
  specialty    String? // doctor-only
  isActive     Boolean @default(true)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  patient              Patient?
  queueEntriesCalled   QueueEntry[]   @relation("DoctorQueueEntries")
  consultations        Consultation[] @relation("DoctorConsultations")
  appointmentsAsDoctor Appointment[]  @relation("DoctorAppointments")
  registeredEntries    QueueEntry[]   @relation("RegisteredByUser")
  createdAppointments  Appointment[]  @relation("CreatedByUser")
  notifications        Notification[]
  auditLogs            AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Patient {
  id           String    @id @default(uuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  matricNumber String?   @unique
  fullName     String
  phone        String?
  email        String?
  dateOfBirth  DateTime?
  gender       String?

  queueEntries  QueueEntry[]
  appointments  Appointment[]
  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matricNumber])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────────────────────
// Appointment
// ─────────────────────────────────────────────────────────────────────────

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       User?             @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  reason       String
  scheduledFor DateTime
  durationMin  Int               @default(20)
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?

  createdById String
  createdBy   User   @relation("CreatedByUser", fields: [createdById], references: [id])

  queueEntry  QueueEntry?
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, scheduledFor])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────
// Queue Entry — the core domain object for the priority queue engine
// ─────────────────────────────────────────────────────────────────────────

model QueueEntry {
  id    String @id @default(uuid())
  token String @unique // e.g. A-014 or E-003

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  queueType QueueType   @default(WALK_IN)
  priority  Priority    @default(ROUTINE)
  status    QueueStatus @default(WAITING)
  reason    String
  notes     String?

  doctorId String?
  doctor   User?   @relation("DoctorQueueEntries", fields: [doctorId], references: [id], onDelete: SetNull)
  room     String?

  registeredById String
  registeredBy   User   @relation("RegisteredByUser", fields: [registeredById], references: [id])

  // Timing
  registeredAt        DateTime  @default(now())
  calledAt            DateTime?
  consultationStartAt DateTime?
  consultationEndAt   DateTime?

  // Wait-time tracking (recomputed by the EWT engine on relevant events)
  estimatedWaitMin Int?
  actualWaitMin    Int?

  consultation Consultation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority, registeredAt])
  @@index([patientId])
  @@index([doctorId])
  @@map("queue_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Consultation — completed record, feeds analytics + rolling EWT average
// ─────────────────────────────────────────────────────────────────────────

model Consultation {
  id           String     @id @default(uuid())
  queueEntryId String     @unique
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("DoctorConsultations", fields: [doctorId], references: [id])

  startedAt   DateTime
  completedAt DateTime
  durationMin Int
  diagnosis   String?
  notes       String?
  vitals      Json? // { bp, temp, pulse, weight, ... }

  createdAt DateTime @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@index([completedAt])
  @@map("consultations")
}

// ─────────────────────────────────────────────────────────────────────────
// Notification — mockable now, WebPush-ready later
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  message String
  read    Boolean          @default(false)
  data    Json? // arbitrary payload (queueEntryId, etc.)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log — tracks sensitive state transitions for research/reporting
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(uuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // e.g. "QUEUE_ENTRY_CREATED", "CONSULTATION_COMPLETED"
  entity   String // e.g. "QueueEntry"
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Clinic settings — singleton-ish config table
// ─────────────────────────────────────────────────────────────────────────

model ClinicSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("clinic_settings")
}
