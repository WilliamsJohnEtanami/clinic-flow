{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
  "root": ".",
  "framework": "tanstack-start",
  "buildCommand": "NITRO_PRESET=vercel npm run build"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "buildCommand": "npm run prisma:generate"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
